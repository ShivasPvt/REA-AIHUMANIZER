# Required: a free Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional settings (defaults shown)
# GEMINI_MODEL=gemini-flash-latest   # free-tier model
# FIDELITY_GATE=on                   # "off" skips the judge check on paraphraser output (saves free-tier quota)
# PORT=3000
# DAILY_WORD_ALLOWANCE=50000
# MAX_CONCURRENT_JOBS=2              # keep low on the free tier's per-minute limits
# TRUST_PROXY=1                      # set when running behind a reverse proxy so visitor IPs are correct
