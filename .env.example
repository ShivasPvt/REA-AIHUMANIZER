# Required: your Anthropic API key
ANTHROPIC_API_KEY=

# Optional settings (defaults shown)
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FALLBACKS=on        # "off" disables server-side refusal fallbacks
# FIDELITY_GATE=on              # "off" skips the judge check on paraphraser output
# PORT=3000
# DAILY_WORD_ALLOWANCE=50000
# MAX_CONCURRENT_JOBS=4
# TRUST_PROXY=1                 # set when running behind a reverse proxy so visitor IPs are correct
